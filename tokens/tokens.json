{
  "$schema": "https://json.schemastore.org/design-tokens",
  "primitive": {
    "color": {
      "blue-950": "#081A4C",
      "blue-900": "#0D2B82",
      "blue-800": "#133EAD",
      "blue-600": "#1A4FD6",
      "blue-400": "#5482FF",
      "blue-300": "#7AA2FF",
      "blue-100": "#DDE7FF",
      "blue-50": "#F0F4FF",
      
      "neutral-0": "#FFFFFF",
      "neutral-50": "#FAFAF7",
      "neutral-100": "#F2F4F7",
      "neutral-200": "#E4E7EC",
      "neutral-300": "#D0D5DD",
      "neutral-400": "#98A2B3",
      "neutral-500": "#667085",
      "neutral-600": "#4A5260",
      "neutral-700": "#344054",
      "neutral-800": "#171B22",
      "neutral-900": "#0E1116",
      "neutral-950": "#080A0D",

      "green-700": "#146339",
      "green-600": "#1B7F4B",
      "green-400": "#5FD39A",
      "green-100": "#D1FADF",

      "amber-700": "#8C4900",
      "amber-600": "#B25E00",
      "amber-400": "#F2B25C",
      "amber-100": "#FEF0C7",

      "red-700": "#991B1B",
      "red-600": "#C62828",
      "red-400": "#FF8A80",
      "red-100": "#FEE4E2"
    },
    "space": {
      "0": 0,
      "1": 4,
      "2": 8,
      "3": 12,
      "4": 16,
      "5": 20,
      "6": 24,
      "8": 32,
      "10": 40,
      "12": 48,
      "16": 64
    },
    "radius": {
      "none": 0,
      "sm": 8,
      "md": 12,
      "lg": 16,
      "full": 9999
    },
    "typography": {
      "font-family-system": "system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif",
      "font-family-mono": "ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, 'Liberation Mono', monospace",
      "size": {
        "caption": 13,
        "body": 17,
        "headline": 17,
        "title": 22,
        "display": 32
      },
      "line-height": {
        "caption": 18,
        "body": 24,
        "headline": 22,
        "title": 28,
        "display": 38
      },
      "weight": {
        "regular": 400,
        "medium": 500,
        "semibold": 600,
        "bold": 700
      }
    }
  },
  "semantic": {
    "color": {
      "bg": {
        "light": "{primitive.color.neutral-50}",
        "dark": "{primitive.color.neutral-900}"
      },
      "surface": {
        "light": "{primitive.color.neutral-0}",
        "dark": "{primitive.color.neutral-800}"
      },
      "surface-raised": {
        "light": "{primitive.color.neutral-0}",
        "dark": "{primitive.color.neutral-700}"
      },
      "border": {
        "light": "{primitive.color.neutral-200}",
        "dark": "{primitive.color.neutral-700}"
      },
      "text-primary": {
        "light": "#14181F",
        "dark": "#F2F4F7"
      },
      "text-secondary": {
        "light": "{primitive.color.neutral-600}",
        "dark": "{primitive.color.neutral-400}"
      },
      "brand": {
        "light": "{primitive.color.blue-600}",
        "dark": "{primitive.color.blue-300}"
      },
      "brand-surface": {
        "light": "{primitive.color.blue-50}",
        "dark": "{primitive.color.blue-950}"
      },
      "state-success": {
        "light": "{primitive.color.green-600}",
        "dark": "{primitive.color.green-400}"
      },
      "state-warning": {
        "light": "{primitive.color.amber-600}",
        "dark": "{primitive.color.amber-400}"
      },
      "state-danger": {
        "light": "{primitive.color.red-600}",
        "dark": "{primitive.color.red-400}"
      }
    }
  },
  "component": {
    "exambar": {
      "height": 52,
      "min-touch-target": 44,
      "elevation": 1
    },
    "timer": {
      "tabular-numbers": true,
      "font-size": 17,
      "warning-threshold-seconds": 300,
      "danger-threshold-seconds": 60
    },
    "button": {
      "min-height": 48,
      "min-width": 44,
      "radius": "{primitive.radius.md}",
      "padding-horizontal": "{primitive.space.4}"
    },
    "input": {
      "min-height": 48,
      "radius": "{primitive.radius.sm}",
      "border-width": 1
    }
  }
}
