# ==============================================================================
# NETRI Exam - Environment Configuration Template (.env.example)
# Salin file ini menjadi .env untuk konfigurasi lokal/staging/produksi.
# JANGAN PERNAH menaruh kredensial rahasia aktual di dalam file template ini!
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Konfigurasi Server API Backend
# ------------------------------------------------------------------------------
PORT=3000
HOST=0.0.0.0
NODE_ENV=development # development | staging | production
API_BASE_URL=https://api.exam.netri.sch.id/v1

# ------------------------------------------------------------------------------
# 2. Database PostgreSQL
# ------------------------------------------------------------------------------
DATABASE_URL=postgresql://netri_user:secure_password@localhost:5432/netri_exam_db

# ------------------------------------------------------------------------------
# 3. Kredensial Otentikasi & Keamanan JWT
# ------------------------------------------------------------------------------
JWT_SECRET=super_secret_jwt_key_at_least_32_characters_long
SESSION_TOKEN_TTL_HOURS=12

# ------------------------------------------------------------------------------
# 4. Kebijakan Ujian & Pengawasan
# ------------------------------------------------------------------------------
DEFAULT_HEARTBEAT_INTERVAL_SECONDS=20
GRACE_PERIOD_SECONDS=10
DEFAULT_MAX_STRIKES=3
PROCTOR_DEFAULT_PIN=1234 # PIN darurat pembukaan kunci oleh pengawas ruang
ALLOWED_DOMAINS_WHITELIST=docs.google.com,forms.google.com,google.com,gstatic.com,googleusercontent.com
